---
import VideoPlayer from './VideoPlayer.astro';
---

<section class="section section--white videosec" id="film">
  <div class="container videosec__inner">
    <div class="videosec__text">
      <p class="eyebrow">Hellere se end læse?</p>
      <h2 class="section-title">Atlas — kort fortalt.</h2>
      <p class="videosec__sub">
        Kortet, forløbene, coachen — og hvordan I måler virkningen.
      </p>
    </div>
    <div class="videosec__player">
      <VideoPlayer src="/videos/atlas-explainer.mp4" poster="/videos/atlas-explainer-poster.jpg" label="Afspil: Atlas — kort fortalt" />
    </div>
  </div>
</section>

<style>
  .videosec {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .videosec__inner {
    display: grid;
    grid-template-columns: 0.8fr 1.4fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .videosec__sub {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    opacity: 0.82;
  }

  @media (max-width: 820px) {
    .videosec__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
