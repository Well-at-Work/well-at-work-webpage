.intervention-deck { isolation: isolate; }
.support-input::after { content: ""; position: absolute; left: -2px; bottom: 0; width: 5px; height: 5px; background: var(--plum); border-radius: 50%; opacity: 0; }
.intervention-module::before { top: -44px; height: 44px; }
.insight-module::after, .intervention-module::after { content: ''; position: absolute; pointer-events: none; left: calc(50% - 2px); width: 5px; height: 5px; border-radius: 50%; background: var(--plum); opacity: 0; }
.insight-module::after { top: -5px; }
.intervention-module::after { top: -3px; }
