  40.952% { opacity: .8; }
  41.667% { opacity: 0; transform: translateY(-23px); }
  67.857% { opacity: 0; transform: translateY(0); }
  68.333% { opacity: .8; }
  69.524% { opacity: .8; }
  70.238% { opacity: 0; transform: translateY(-23px); }
