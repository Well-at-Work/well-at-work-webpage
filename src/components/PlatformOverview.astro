.flow-toggle-icon { width: 12px; text-align: center; font-size: .7rem; }
/* Separate arrivals at 0, 15 and 27 seconds in a quiet 42-second cycle. */
@media(prefers-reduced-motion: no-preference) {
  .is-flow-ready .insight-module:nth-of-type(1)::after { animation: insight-apv 42s linear infinite; }
  .is-flow-ready .insight-module:nth-of-type(2)::after { animation: insight-individual 42s linear infinite; }
  .is-flow-ready .insight-module:nth-of-type(3)::after { animation: insight-teams 42s linear infinite; }
  .is-flow-ready .intervention-module::after { animation: reporting-flow 42s linear infinite; }
  .is-flow-ready .support-input::after { animation: support-flow 42s linear infinite; }
  .is-flow-ready .loop-pulse { animation: feedback-flow 42s linear infinite; }
  .is-flow-ready .insight-module::after, .is-flow-ready .intervention-module::after, .is-flow-ready .loop-pulse, .is-flow-ready .support-input::after { animation-play-state: paused; }
  .is-flow-active .insight-module::after, .is-flow-active .intervention-module::after, .is-flow-active .loop-pulse, .is-flow-active .support-input::after { animation-play-state: running; }
}
