<section class="platform-section section" id="platformen">
  <div class="container">
    <div class="section-intro section-intro--center">
      <p class="eyebrow">HELE PLATFORMEN. ÉT SAMLET ARBEJDE.</p>
      <h2 class="section-title">Forstå behovene.<br />Sæt ind. Følg udviklingen.</h2>
      <p class="section-subtitle">Personlig støtte bliver mere relevant, når den bygger på indsigt. Opfølgningen hjælper jer med at kvalificere den næste indsats.</p>
    </div>
    <figure class="platform-figure" aria-label="Well at Work: indsigt, støtte og opfølgning på et fælles fundament">
      <div class="platform-foundation">
        <div class="platform-system">
          <div class="feedback-stages">
            <div class="reporting-layer">
              <span class="layer-label">Læring &amp; rapportering</span>
            <a class="reporting-module platform-module" href="/platform#rapportering">
              <div><h3>Lær, hvad der virker</h3><p>Følg organisationens trivsel med rapporter, handlingsplaner og løbende opfølgning.</p></div>
              <span class="module-arrow" aria-hidden="true">↗</span>
            </a>
            </div>
            <div class="intervention-deck">
              <span class="layer-label">Indsats</span>
              <a class="intervention-module platform-module" href="/platform#personlige-forloeb">
                <span class="module-audience">FOR MEDARBEJDEREN</span>
                <h3>Personlige forløb <span aria-hidden="true">↗</span></h3>
                <p>Øvelser og nye vaner</p><span class="support-input" aria-hidden="true"></span>
              </a>
              <a class="intervention-module platform-module" href="/platform#ledelsescoach">
                <span class="module-audience">FOR LEDEREN</span>
                <h3>Ledelses<wbr />coach <span aria-hidden="true">↗</span></h3>
                <p>Sparring og næste skridt</p><span class="support-input" aria-hidden="true"></span>
              </a>
            </div>
            <span class="learning-loop" aria-hidden="true"><svg viewBox="0 0 30 100" preserveAspectRatio="none"><path class="loop-track" d="M0 1H14Q29 1 29 15V85Q29 99 14 99H1" vector-effect="non-scaling-stroke"/><path class="loop-pulse" d="M0 1H14Q29 1 29 15V85Q29 99 14 99H1" pathLength="100" vector-effect="non-scaling-stroke"/></svg></span>
          </div>
          <div class="insight-modules">
            <span class="layer-label">Måling</span>
            <a class="insight-module platform-module" href="/platform#apv"><h3>APV <span aria-hidden="true">↗</span></h3><p>Arbejdspladsens rammer <br />og arbejdsmiljø</p></a>
            <a class="insight-module platform-module" href="/platform#atlas-individual"><h3>Atlas Individual <span aria-hidden="true">↗</span></h3><p>Trivsel, ressourcer <br />og individuelle behov</p></a>
            <a class="insight-module platform-module" href="/platform#atlas-teams"><h3>Atlas Teams <span aria-hidden="true">↗</span></h3><p>Samarbejde, ledelse <br />og teamets dynamik</p></a>
          </div>
        </div>
        <div class="platform-base"><div class="platform-brand"><img src="/images/brand/mark.png" width="30" height="30" alt="" loading="lazy" /><strong>Well at Work</strong></div><p>Et fælles fundament for trivsel og udvikling</p></div>
      </div>
      <figcaption class="platform-learning"><span class="learning-symbol" aria-hidden="true">↻</span><p><span class="learning-label">Vores ambition</span> Støtte, der lærer, hvad der hjælper jer.</p></figcaption>
      <div class="flow-controls" hidden><button class="flow-toggle" type="button" aria-label="Sæt informationsflowets animation på pause"><span class="flow-toggle-icon" aria-hidden="true">Ⅱ</span><span class="flow-toggle-text">Pause bevægelse</span></button></div>
    </figure>
    <div class="platform-more"><a href="/platform" class="text-link">Udforsk hele platformen</a></div>
  </div>
</section>
