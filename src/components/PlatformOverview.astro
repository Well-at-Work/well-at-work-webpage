<script>
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.platform-figure').forEach((figure) => {
    const controls = figure.querySelector<HTMLElement>('.flow-controls');
    const button = figure.querySelector<HTMLButtonElement>('.flow-toggle');
    if (!controls || !button) return;
    let visible = false;
    let paused = false;
    const sync = () => {
      const motionAllowed = !motionPreference.matches;
      controls.hidden = !motionAllowed;
      figure.classList.toggle('is-flow-ready', motionAllowed);
      figure.classList.toggle('is-flow-active', motionAllowed && visible && !paused && !document.hidden);
      button.setAttribute('aria-label', paused ? 'Start informationsflowets animation' : 'Sæt informationsflowets animation på pause');
      button.querySelector('.flow-toggle-text')!.textContent = paused ? 'Vis bevægelse' : 'Pause bevægelse';
      button.querySelector('.flow-toggle-icon')!.textContent = paused ? '▷' : 'Ⅱ';
    };
    button.addEventListener('click', () => { paused = !paused; sync(); });
    motionPreference.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }, { threshold: .15 }).observe(figure);
    sync();
  });
</script>
