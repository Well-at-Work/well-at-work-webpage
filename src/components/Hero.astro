---
import CoachPreview from './CoachPreview.astro';
---
<section class="hero">
  <div class="container hero-layout">
    <div class="hero-copy">
      <p class="eyebrow">TRIVSEL & LEDELSESUDVIKLING</p>
      <h1>Styrk trivslen.<br />Giv jeres ledere<br /><span>støtte til at lykkes.</span></h1>
      <p class="hero-description">Personlige forløb til medarbejderne. Coaching til lederne. Én samlet platform, der hjælper jer med at sætte ind dér, hvor det gør en forskel.</p>
      <div class="hero-actions"><a href="/#kontakt" class="btn btn--primary">Book en demo <span aria-hidden="true">↗</span></a><a href="#platformen" class="hero-secondary">Se platformen <span aria-hidden="true">↓</span></a></div>
      <p class="hero-foundation">Med afsæt i psykologi, neurovidenskab<br class="desktop-break" /> og indsigt i jeres medarbejdere og teams.</p>
    </div>
    <div class="hero-product">
      <div class="hero-coach"><CoachPreview /></div>
      <div class="track-mini"><div class="track-icon" aria-hidden="true">↗</div><div><span>DIT PERSONLIGE FORLØB</span><strong>Små skridt. Mere overskud.</strong><p>Stabil vækst · 14 dage</p></div><span class="track-check" aria-hidden="true">✓</span></div>
    </div>
  </div>
</section>
<style>
.hero { background: white; padding: 5rem 0 4.5rem; overflow: clip; }
.hero-layout { display: grid; grid-template-columns: 1.04fr 1fr; align-items: center; gap: 3rem; }
.hero-copy { padding: 1rem 0 1.8rem; }
.hero .eyebrow { font-size: .68rem; letter-spacing: .13em; margin-bottom: 1.5rem; }
h1 { font-size: clamp(2.8rem, 4.35vw, 3.95rem); line-height: 1.08; letter-spacing: var(--heading-spacing); font-weight: 650; margin-bottom: 1.5rem; }
h1 span { color: var(--plum); }
.hero-description { max-width: 470px; color: var(--text-muted); font-size: 1.075rem; line-height: 1.75; }
.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.8rem; margin-top: 2rem; font-size: .9rem; }
.hero-actions .btn span { margin-left: 1.15rem; }
.hero-secondary { font-weight: 600; color: var(--plum); }
.hero-secondary span { margin-left: .65rem; }
.hero-secondary:hover { text-decoration: underline; text-underline-offset: 5px; }
.hero-foundation { font-size: .76rem; line-height: 1.6; color: var(--text-muted); margin-top: 1.75rem; }
.hero-product { position: relative; padding: 0 0 38px 20px; }
.hero-coach { position: relative; margin-right: 13px; }
.track-mini { position: relative; display: flex; align-items: center; gap: 13px; background: white; padding: 18px 20px; margin: 14px 33px -15px -20px; border: 1px solid #ddd6da; border-left: 3px solid var(--plum); border-radius: 9px; box-shadow: 0 2px 5px #45203704; }
.track-icon { width: 41px; height: 44px; display: grid; place-items: center; background: #f6f2ed; color: var(--plum); border-radius: 50%; font-size: 1.8rem; }
.track-mini div > span { display: block; color: var(--bronze); font-size: .56rem; font-weight: 700; letter-spacing: .1em; }
.track-mini strong { display: block; font-size: .87rem; margin-top: 2px; }
.track-mini p { font-size: .67rem; color: var(--text-muted); margin-top: 3px; }
.track-check { margin-left: auto; width: 25px; height: 25px; display: grid; place-items: center; border: 1px solid #dcdde0; color: var(--bronze); border-radius: 50%; font-size: .75rem; }
@media(max-width: 1000px) { .hero-layout { gap: 2rem; } h1 { font-size: clamp(2.6rem, 4.7vw, 3.7rem); } }
@media(max-width: 800px) { .hero { padding: 3rem 0; } .hero-layout { grid-template-columns: 1fr; gap: 2.5rem; } .hero-copy { padding: 0; } h1 { font-size: clamp(2.75rem, 7.5vw, 4.2rem); } .hero-description { max-width: 560px; } .hero-product { max-width: 530px; width: 100%; margin-inline: auto; } .hero-foundation br { display: none; } }
@media(max-width: 400px) { .hero-actions { gap: 1.25rem; } .hero-product { padding-left: 8px; } .track-mini { margin-left: -7px; margin-right: 0; padding: 16px 12px; } h1 { font-size: 2.5rem; } }
</style>
