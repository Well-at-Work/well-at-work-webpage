---
import { localeFor, routeFor } from '../i18n/routes';
const locale = localeFor(Astro.url.pathname);
const route = routeFor(Astro.url.pathname) ?? { da: '/', en: '/en/' };
---
<div class="language-switch" role="group" aria-label={locale === 'en' ? 'Choose language' : 'Vælg sprog'} data-i18n-skip>
  <a href={route.da} lang="da" hreflang="da" aria-label="Dansk" aria-current={locale === 'da' ? 'true' : undefined}>DA</a>
  <span aria-hidden="true">/</span>
  <a href={route.en} lang="en" hreflang="en" aria-label="English" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
</div>
<style>
.language-switch { display: flex; flex: none; align-items: center; gap: .1rem; font-size: .72rem; font-weight: 500; letter-spacing: .035em; }
.language-switch a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 .35rem; color: inherit; }
.language-switch a[aria-current] { font-weight: 750; text-decoration: underline; text-underline-offset: 5px; }
.language-switch a:hover { text-decoration: underline; text-underline-offset: 5px; }
.language-switch span { opacity: .4; }
</style>
<script>
// Preserve the section and query when changing language; normal links also work without JS.
document.querySelectorAll<HTMLAnchorElement>('.language-switch a').forEach(link => {
  const target = new URL(link.href);
  target.hash = window.location.hash;
  target.search = window.location.search;
  link.href = target.href;
  window.addEventListener('hashchange', () => {
    const updated = new URL(link.href);
    updated.hash = window.location.hash;
    link.href = updated.href;
  });
});
</script>
