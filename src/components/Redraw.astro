---
import { terrainRings, flowLine } from '../lib/terrain.js';

// Same seeds — it is literally the same map, redrawn.
// Pressure zone uses 4 rings on both ends so path commands match for interpolation.
const land = terrainRings({ seed: 301, cx: 150, cy: 103, rMax: 96, rings: 3, points: 12, wobble: 0.48, rMinFrac: 0.82, stretchX: 1.35 });
const calmA = terrainRings({ seed: 321, cx: 96, cy: 86, rMax: 30, rings: 3, points: 8, wobble: 0.4, rMinFrac: 0.4 });
const calmB = terrainRings({ seed: 332, cx: 150, cy: 150, rMax: 24, rings: 2, points: 8, wobble: 0.42, rMinFrac: 0.45 });
const zoneBefore = terrainRings({ seed: 365, cx: 205, cy: 92, rMax: 42, rings: 4, points: 9, wobble: 0.36, rMinFrac: 0.28 });
const zoneAfter = terrainRings({ seed: 365, cx: 205, cy: 92, rMax: 24, rings: 4, points: 9, wobble: 0.36, rMinFrac: 0.45 });
const flows = [0, 1, 2].map(i => flowLine({ seed: 400 + i * 9, y: 40 + i * 62, width: 300, amp: 10, segments: 4 }));

const beforeFills = ['#f6e3d8', '#f3d2ba', '#efbf9d', '#ecab81'];
const afterFills = ['#dcead9', '#cfe0d4', '#dcead9', '#cfe0d4'];

const morph = {
  zoneBefore,
  zoneAfter,
  beforeFills,
  afterFills,
  strokeBefore: '#d85a30',
  strokeAfter: '#8fae94',
  dotBefore: '#d85a30',
  dotAfter: '#7fae8f',
};
---

<section class="section section--beige redraw" id="forandring">
  <div class="redraw__scene" data-redraw-scene>
    <div class="redraw__sticky">
      <div class="container">
        <h2 class="section-title" style="text-align:center;">Og kortet forandrer sig — fordi I handlede.</h2>
        <p class="section-subtitle" style="text-align:center; margin-left:auto; margin-right:auto;">
          Når I ændrer noget i virkeligheden, tegner Atlas kortet om ved næste måling — så I kan
          se, om det virkede. Og Atlas lærer, hvad der virker hos netop jer, så forløb og
          anbefalinger bliver skarpere for hver gang.
        </p>

        <figure
          class="redraw__panel"
          data-redraw-panel
          aria-label="Illustration: samme kort ved to målinger — presset falder efter handling"
        >
          <svg viewBox="0 0 300 210" aria-hidden="true">
            <g fill="none" stroke="#c96f43" stroke-width="0.9" stroke-linecap="round" opacity="0.3">
              {flows.map(d => <path d={d}/>)}
            </g>
            <path d={land[0]} fill="#f9efe0" fill-opacity="0.8" stroke="#c96f43" stroke-width="1" stroke-opacity="0.3"/>
            <path d={land[1]} fill="none" stroke="#c96f43" stroke-width="0.9" stroke-opacity="0.2"/>
            {calmA.map((d, i) => <path d={d} fill={i === 0 ? '#e3ecdf' : 'none'} fill-opacity="0.55" stroke="#8fae94" stroke-width="0.9" stroke-opacity={0.3 + i * 0.1}/>)}
            {calmB.map((d, i) => <path d={d} fill={i === 0 ? '#e3ecdf' : 'none'} fill-opacity="0.45" stroke="#8fae94" stroke-width="0.9" stroke-opacity={0.28 + i * 0.1}/>)}
            {zoneBefore.map((d, i) => (
              <path
                class="redraw__zone"
                d={d}
                fill={beforeFills[i]}
                fill-opacity="0.55"
                stroke="#d85a30"
                stroke-width="1"
                stroke-opacity={0.3 + i * 0.16}
              />
            ))}
            <circle class="redraw__dot" cx="205" cy="92" r="4.5" fill="#d85a30"/>
          </svg>

          <figcaption>
            <span class="redraw__handling" data-redraw-handling aria-hidden="true">
              <svg viewBox="0 0 44 20" width="40" height="18" fill="none" stroke="#3d5138" stroke-width="1.8" stroke-linecap="round">
                <path d="M2 10 H 38 M32 4 38 10 32 16"/>
              </svg>
              <span>handling</span>
            </span>
            <span class="redraw__state redraw__state--before" data-redraw-before>
              Måling 1 <span class="redraw__tag redraw__tag--coral">højt pres</span>
            </span>
            <span class="redraw__state redraw__state--after" data-redraw-after>
              Måling 2 <span class="redraw__tag redraw__tag--sage">presset faldt</span>
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="redraw__drivers">
      <p class="redraw__proof-label">Fra en organisation på platformen</p>
      <h3 class="redraw__drivers-title">Hvad trak presset ned?</h3>
      <p class="redraw__drivers-lead">
        Da udbrændtheden aftog, bevægede de bagvedliggende drivere sig med — hver i den rigtige retning.
      </p>

      <ul class="redraw__grid">
        <li class="driver">
          <span class="driver__arrow" aria-hidden="true">↓</span>
          <div>
            <p class="driver__name">Krav</p>
            <p class="driver__desc">Færre belastende krav i hverdagen.</p>
          </div>
        </li>
        <li class="driver">
          <span class="driver__arrow" aria-hidden="true">↑</span>
          <div>
            <p class="driver__name">Ressourcer</p>
            <p class="driver__desc">Mere støtte og overskud at trække på.</p>
          </div>
        </li>
        <li class="driver">
          <span class="driver__arrow" aria-hidden="true">↑</span>
          <div>
            <p class="driver__name">Motivation</p>
            <p class="driver__desc">Mere indre drive og mening i arbejdet.</p>
          </div>
        </li>
        <li class="driver">
          <span class="driver__arrow" aria-hidden="true">↓</span>
          <div>
            <p class="driver__name">Bekymring</p>
            <p class="driver__desc">Det skjulte pres i kortet aftog.</p>
          </div>
        </li>
      </ul>

      <p class="redraw__insight">
        Den tydeligste forklaring på, hvem der kom sig: <strong>voksende indre motivation.</strong>
      </p>
      <p class="redraw__legend">Grøn pil = bevægelse i den rigtige retning.</p>
    </div>

    <p class="redraw__learn">Jo længere I bruger Atlas, jo bedre kender det jeres organisation.</p>
  </div>
</section>

<script type="application/json" id="redraw-morph" is:inline set:html={JSON.stringify(morph)} />

<script>
  import { lerpPath } from '../lib/terrain.js';

  const scene = document.querySelector('[data-redraw-scene]');
  const panel = document.querySelector('[data-redraw-panel]');
  const payload = document.getElementById('redraw-morph');
  if (!scene || !panel || !payload) {
    // no-op if the section is not on this page
  } else {
    const data = JSON.parse(payload.textContent || '{}');
    const zonePaths = panel.querySelectorAll('.redraw__zone');
    const dot = panel.querySelector('.redraw__dot');
    const handling = panel.querySelector('[data-redraw-handling]');
    const beforeCap = panel.querySelector('[data-redraw-before]');
    const afterCap = panel.querySelector('[data-redraw-after]');
    const sticky = scene.querySelector('.redraw__sticky');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    function hexToRgb(hex) {
      const n = parseInt(hex.slice(1), 16);
      return [n >> 16, (n >> 8) & 255, n & 255];
    }

    function lerpColor(a, b, t) {
      const A = hexToRgb(a);
      const B = hexToRgb(b);
      const r = Math.round(A[0] + (B[0] - A[0]) * t);
      const g = Math.round(A[1] + (B[1] - A[1]) * t);
      const bl = Math.round(A[2] + (B[2] - A[2]) * t);
      return `rgb(${r}, ${g}, ${bl})`;
    }

    function easeInOut(t) {
      return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    }

    function clamp01(t) {
      return Math.max(0, Math.min(1, t));
    }

    function apply(rawT) {
      const t = easeInOut(clamp01(rawT));
      zonePaths.forEach((path, i) => {
        const d0 = data.zoneBefore[i];
        const d1 = data.zoneAfter[i];
        if (d0 && d1) path.setAttribute('d', lerpPath(d0, d1, t));
        path.setAttribute('fill', lerpColor(data.beforeFills[i], data.afterFills[i], t));
        path.setAttribute('stroke', lerpColor(data.strokeBefore, data.strokeAfter, t));
        // Outer + innermost stay; the two middle contours recede (matches 4-ring → 2-ring story)
        const keep = i === 0 || i === 3 ? 1 : 1 - t;
        path.setAttribute('fill-opacity', String((0.55 * keep).toFixed(2)));
        path.setAttribute('stroke-opacity', String(((0.3 + i * 0.16) * keep).toFixed(2)));
      });
      if (dot) {
        dot.setAttribute('fill', lerpColor(data.dotBefore, data.dotAfter, t));
        dot.setAttribute('r', (4.5 - 0.5 * t).toFixed(1));
      }
      if (handling) {
        const h = t > 0.32 && t < 0.68 ? Math.sin((t - 0.32) / 0.36 * Math.PI) : 0;
        handling.style.opacity = String(h.toFixed(3));
      }
      if (beforeCap) beforeCap.style.opacity = t < 0.38 ? '1' : '0';
      if (afterCap) afterCap.style.opacity = t > 0.62 ? '1' : '0';
      panel.classList.toggle('redraw__panel--after', t > 0.55);
    }

    function progress() {
      const sceneRect = scene.getBoundingClientRect();
      const stickyH = sticky ? sticky.offsetHeight : window.innerHeight;
      const range = Math.max(scene.offsetHeight - stickyH, 1);
      const navOffset = sticky ? (parseFloat(getComputedStyle(sticky).top) || 0) : 0;
      return clamp01((navOffset - sceneRect.top) / range);
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        apply(progress());
        ticking = false;
      });
    }

    function bind() {
      if (reduce.matches) {
        apply(1);
        return;
      }
      apply(progress());
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    }

    bind();
    reduce.addEventListener?.('change', () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      bind();
    });
  }
</script>

<style>
  #forandring.redraw {
    padding-top: 0;
  }

  .redraw__scene {
    height: 220vh;
  }

  .redraw__sticky {
    position: sticky;
    top: 72px;
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    padding: var(--section-padding) 0 2rem;
  }

  .redraw__panel {
    position: relative;
    background: var(--warm-white);
    border: 1px solid var(--border-warm);
    border-radius: var(--card-radius);
    padding: 0.85rem 0.85rem 0.65rem;
    box-shadow: 0 10px 28px rgba(45, 46, 90, 0.08);
    width: min(560px, 100%);
    margin: 0 auto;
  }

  .redraw__panel--after {
    border-color: #cfe0d4;
  }

  .redraw__panel > svg {
    width: 100%;
    height: auto;
    max-height: min(42vh, 360px);
    display: block;
  }

  .redraw__panel figcaption {
    position: relative;
    min-height: 2.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--navy);
    margin-top: 0.4rem;
  }

  .redraw__handling,
  .redraw__state {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .redraw__handling {
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage-deep);
    pointer-events: none;
    opacity: 0;
  }

  .redraw__state--after {
    opacity: 0;
  }

  .redraw__tag {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 2px 10px;
    border-radius: 999px;
  }

  .redraw__tag--coral {
    background: var(--coral-soft);
    color: #a8401c;
  }

  .redraw__tag--sage {
    background: var(--sage-soft);
    color: var(--sage-deep);
  }

  .redraw__drivers {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .redraw__proof-label {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage-deep);
    margin-bottom: 0.6rem;
  }

  .redraw__drivers-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }

  .redraw__drivers-lead {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 520px;
    margin: 0 auto 1.5rem;
  }

  .redraw__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    text-align: left;
  }

  .driver {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: var(--warm-white);
    border: 1px solid var(--border-warm);
    border-radius: var(--card-radius);
    padding: 1rem 1.15rem;
  }

  .driver__arrow {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    background: var(--sage-soft);
    color: var(--sage-deep);
  }

  .driver__name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--navy);
  }

  .driver__desc {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  .redraw__insight {
    margin: 1.5rem auto 0;
    max-width: 560px;
    background: var(--sage-soft);
    color: var(--navy);
    border-radius: var(--card-radius);
    padding: 0.9rem 1.4rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  .redraw__insight strong { color: var(--sage-deep); font-weight: 700; }

  .redraw__legend {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 0.7rem;
  }

  @media (max-width: 560px) {
    .redraw__grid { grid-template-columns: 1fr; }
    .redraw__sticky { padding-top: 1.25rem; }
  }

  .redraw__learn {
    text-align: center;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--navy);
    margin-top: 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .redraw__scene { height: auto; }
    .redraw__sticky {
      position: static;
      min-height: 0;
    }
    .redraw__handling { display: none; }
    .redraw__state--before { display: none; }
    .redraw__state--after { position: absolute; opacity: 1; }
  }
</style>
