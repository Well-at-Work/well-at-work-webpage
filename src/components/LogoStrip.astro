---
const logos = [
  'Tandlægeforeningen',
  'Asnet',
  'Aparta',
  'PS Contact',
  'Moderaterne',
];
---

<section class="logo-strip" aria-label="Bruges af blandt andre">
  <div class="container logo-strip__inner">
    <p class="logo-strip__label">Bruges af</p>
    <div class="logo-strip__items">
      {logos.map(name => (
        <span class="logo-strip__item">{name}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .logo-strip {
    padding: 1.6rem 0;
    background: var(--warm-white);
    border-top: 1px solid var(--border-warm);
    border-bottom: 1px solid var(--border-warm);
  }

  .logo-strip__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 2.5rem;
    flex-wrap: wrap;
  }

  .logo-strip__label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .logo-strip__items {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 2.25rem;
    justify-content: center;
  }

  .logo-strip__item {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--navy);
    opacity: 0.45;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
</style>
