---
import { customers } from '../data/customers';
---
<section class="proof-strip" aria-label="Kunder og samarbejdspartnere"><div class="container"><p>I godt selskab med kunder og samarbejdspartnere</p><div class="proof-names">{customers.map(name => <span>{name}</span>)}</div></div></section>
<style>
.proof-strip { padding: 2rem 0 2.5rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: white; text-align: center; }
.proof-strip p { font-size: .72rem; color: var(--text-muted); margin-bottom: 1.4rem; }
.proof-names { display: flex; justify-content: center; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }
.proof-names span { flex: 0 1 calc((100% - 8rem) / 5); font-size: clamp(.95rem,1.5vw,1.2rem); font-weight: 650; letter-spacing: -.03em; color: #68606c; }
.proof-names span:nth-child(2) { text-transform: lowercase; font-size: 1.8rem; font-weight: 500; letter-spacing: -.07em; }
.proof-names span:nth-child(4) { letter-spacing: .07em; font-size: 1rem; }
@media(max-width:900px) { .proof-names span { flex-basis: calc((100% - 4rem) / 3); } }
@media(max-width:600px) { .proof-names { gap: .8rem 1.6rem; } .proof-names span { flex-basis: calc((100% - 1.6rem) / 2); } }
</style>
