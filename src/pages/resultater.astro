---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const testimonials = [
  {
    quote: 'Som organisationspsykolog kan jeg på få minutter opnå samme dybe indsigt fra Well at Works banebrydende organisationsdata, som det ellers ville tage mig dage at indsamle gennem observationer og medarbejderinterviews.',
    name: 'Helge Larsen',
    role: 'Ejer, FRANQ ApS',
    image: '/images/people/helge-larsen.png',
  },
  {
    quote: 'Vores egne undersøgelser viser, at 60 % af alle tandlæger har oplevet udbrændthed eller manglende arbejdsglæde inden for de seneste seks måneder. Som reaktion på disse resultater valgte vi at indgå et partnerskab med Well at Work i testfasen af deres teknologi. I dag har nogle af vores medlemmer fra testperioden allerede indgået bilaterale aftaler med Well at Work, og vi ser frem til at kunne udbrede deres innovative well-being-målinger til flere af vores medlemmer.',
    name: 'Noa Jankovic',
    role: 'Vicedirektør, Tandlægeforeningen',
    image: '/images/people/noa-jankovic.jpg',
  },
  {
    quote: 'I kølvandet på en række sager om dårlige psykiske arbejdsvilkår i vores politiske sekretariat hyrede jeg som konstitueret sekretariatschef Well at Work og en organisationspsykolog ind til at hjælpe os med at forbedre trivslen. Vi har efterfølgende besluttet at forlænge samarbejdet.',
    name: 'Morten E. G. J. Brautsch',
    role: 'Særlig rådgiver for udenrigsministeren',
    image: '/images/people/morten-brautsch.jpg',
  },
  {
    quote: 'Som direktør for Danmarks største bestyrelsesnetværk ser jeg frem til at kunne tilbyde mine medlemmer adgang til Well at Works banebrydende tilgang til at optimere både medarbejder- og ledertrivsel. Deres teknologi identificerer ikke kun stress, men optimerer også produktiviteten og gør det muligt at handle proaktivt, hvilket sikrer sundere og mere engagerede medarbejdere og ledere – til gavn for bundlinjen.',
    name: 'Henrik Nielsen',
    role: 'Direktør, Asnet',
    image: '/images/people/henrik-nielsen.png',
  },
];

const stories = [
  {
    client: 'Tandlægeforeningen',
    headline: 'Fra bekymrende trivselsdata til bilaterale aftaler',
    text: 'Tandlægeforeningens egne undersøgelser viste, at 60 % af alle tandlæger havde oplevet udbrændthed eller manglende arbejdsglæde inden for de seneste seks måneder. Et partnerskab med Well at Work i teknologiens testfase har siden ført til, at nogle medlemmer har indgået bilaterale aftaler.',
  },
  {
    client: 'Moderaterne',
    headline: 'Fra kriseindsats til udvidet partnerskab',
    text: 'Moderaternes partisekretariat henvendte sig til Well at Work i forbindelse med en krisesituation. Den indledende indsats var så værdifuld, at samarbejdet blev udvidet til et løbende partnerskab om trivsel og organisationsudvikling.',
  },
];

const logos = [
  'Tandlægeforeningen',
  'Asnet',
  'Aparta',
  'PS Contact',
  'Moderaterne',
];
---

<Base title="Resultater — Well at Work" description="Cases og testimonials fra organisationer der bruger Well at Work til at skabe målbar forbedring i trivsel og performance.">
  <Navbar />
  <main>
    <section class="section section--beige">
      <div class="container" style="text-align:center;">
        <h1 class="section-title">Resultater</h1>
        <p class="section-subtitle">
          Fra pilotprojekter til langvarige partnerskaber — se hvordan organisationer bruger Well at Work til at skabe reel forandring.
        </p>
      </div>
    </section>

    <section class="section section--white">
      <div class="container">
        <h2 class="section-title">Hvad vores kunder siger</h2>
        <div class="resultater-testimonials">
          {testimonials.map(t => (
            <article class="resultater-card">
              {t.image ? (
                <img
                  class="resultater-card__avatar"
                  src={t.image}
                  alt={`Portræt af ${t.name}`}
                  loading="lazy"
                  width="72"
                  height="72"
                />
              ) : (
                <div class="resultater-card__avatar resultater-card__avatar--fallback" aria-hidden="true">
                  {t.name.split(' ').map(part => part[0]).join('')}
                </div>
              )}
              <blockquote class="resultater-card__quote">
                <p>&ldquo;{t.quote}&rdquo;</p>
              </blockquote>
              <footer class="resultater-card__attribution">
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--beige">
      <div class="container">
        <h2 class="section-title">Kundehistorier</h2>
        <p class="section-subtitle">
          Konkrete eksempler på, hvordan organisationer har brugt Well at Work — og hvad det har ført til.
        </p>
        <div class="resultater-stories">
          {stories.map(story => (
            <article class="card">
              <p class="resultater-story__client">{story.client}</p>
              <h3 class="card-title">{story.headline}</h3>
              <p class="card-text">{story.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--white">
      <div class="container" style="text-align:center;">
        <blockquote class="resultater-pullquote">
          <p>&ldquo;Grundig, sjov, betydningsfuld&rdquo;</p>
          <footer>— Tilbagemelding fra pilotrespondenter</footer>
        </blockquote>
      </div>
    </section>

    <section class="resultater-logos section section--beige">
      <div class="container">
        <p class="resultater-logos__label">Organisationer der bruger Well at Work</p>
        <div class="resultater-logos__strip">
          {logos.map(name => (
            <span class="resultater-logos__item">{name}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--navy">
      <div class="container" style="text-align:center;">
        <h2 style="font-family:var(--font-heading);font-size:var(--text-h1);margin-bottom:1rem;">Klar til at se resultater i jeres organisation?</h2>
        <p style="max-width:600px;margin:0 auto 2rem;opacity:0.85;line-height:1.7;">
          Book en uforpligtende demo — vi viser jer, hvad 15 minutter kan afsløre.
        </p>
        <a href="/#kontakt" class="btn btn--white">Book demo</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .resultater-testimonials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: var(--card-gap);
    margin-top: 2rem;
  }

  .resultater-card {
    background: var(--white);
    border-left: 4px solid var(--plum);
    border-radius: 0 var(--card-radius) var(--card-radius) 0;
    padding: 2rem;
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .resultater-card__avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: var(--lavender);
    object-fit: cover;
    object-position: center;
    flex-shrink: 0;
  }

  .resultater-card__avatar--fallback {
    display: grid;
    place-items: center;
    color: var(--navy);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .resultater-card__quote p {
    font-size: var(--text-body-lg);
    line-height: 1.7;
    color: var(--navy);
  }

  .resultater-card__attribution {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .resultater-card__attribution strong {
    font-weight: 600;
    color: var(--navy);
  }

  .resultater-card__attribution span {
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  /* Customer stories */
  .resultater-stories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--card-gap);
  }

  .resultater-story__client {
    font-size: var(--text-small);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  /* Pull quote */
  .resultater-pullquote {
    max-width: 640px;
    margin: 0 auto;
    padding: 2.5rem;
  }

  .resultater-pullquote p {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    color: var(--navy);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .resultater-pullquote footer {
    font-size: var(--text-small);
    color: var(--text-muted);
    font-style: italic;
  }

  /* Logo strip */
  .resultater-logos {
    text-align: center;
  }

  .resultater-logos__label {
    font-size: var(--text-small);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }

  .resultater-logos__strip {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem 3rem;
  }

  .resultater-logos__item {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--navy);
    opacity: 0.45;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
</style>
