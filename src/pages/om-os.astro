---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const team = [
  {
    name: 'Svend Aage Kirk',
    title: 'CEO',
    bio: '40+ års erfaring med international forretningsudvikling, salg, strategi og vækst på tværs af brancher.',
    image: '/images/people/svend-aage-kirk.webp',
    imagePosition: 'center',
  },
  {
    name: 'Nikolas Nemeth',
    title: 'Head of Public Sector Relations',
    bio: '15+ års erfaring med strategi, offentlige anliggender og organisationsudvikling.',
    image: '/images/people/nikolas-nemeth.jpg',
    imagePosition: '66% center',
  },
  {
    name: 'Kim Mouridsen',
    title: 'CTO & medstifter',
    bio: 'Professor i neurovidenskab, Aarhus Universitet. 20+ forskningsmæssige priser. 13 millioner brugere på tværs af tidligere platforme. FDA-godkendte medicinsk AI-løsninger (Cercare Medical, Mindway AI). Tidligere forsker i Karl Fristons laboratorium, University College London.',
    image: undefined,
    imagePosition: 'center',
  },
  {
    name: 'Lisa Beuschau',
    title: 'Head of Interventions',
    bio: 'Forfatter til "1-Minut Metoden." Designer af evidensbaserede mikro-øvelser og personlige interventionsprogrammer.',
    image: '/images/people/lisa-beuschau.webp',
    imagePosition: 'center',
  },
  {
    name: 'Helge Larsen',
    title: 'Organisationspsykolog',
    bio: 'Specialiseret i arbejdspladstrivsel, organisatorisk forandring og ledelsesrådgivning.',
    image: '/images/people/helge-larsen.png',
    imagePosition: 'center',
  },
];

const board = [
  {
    name: 'Niels Ankerstjerne',
    role: 'Bestyrelsesformand · Partner, DLA Piper',
    focus: 'VC/PE · Juridisk og corporate governance',
    image: '/images/people/niels-ankerstjerne.jpg',
    imagePosition: 'center 18%',
  },
];
---

<Base title="Om os — Well at Work" description="Mød teamet bag Well at Work — grundlagt i neurovidenskab, bygget til at skabe reel forandring i organisationers trivsel.">
  <Navbar />
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">MENNESKERNE BAG WELL AT WORK</p><h1>Vi gør viden om trivsel<br />til støtte i hverdagen.</h1>
        <p class="section-subtitle">
          Vi samler neurovidenskab, organisationspsykologi og teknologi for at give medarbejdere og ledere konkrete redskaber til en bedre arbejdsdag.
        </p>
      </div>
    </section>

    <section class="section section--white">
      <div class="container">
        <h2 class="section-title">Teamet</h2>
        <div class="om-team">
          {team.map(person => (
            <article class="om-person">
              {person.image ? (
                <img
                  class="om-person__avatar"
                  src={person.image}
                  alt={`Portræt af ${person.name}`}
                  loading="lazy"
                  width="96"
                  height="96"
                  style={person.imagePosition ? `object-position:${person.imagePosition}` : undefined}
                />
              ) : (
                <div class="om-person__avatar om-person__avatar--fallback" aria-hidden="true">
                  <span>{person.name.split(' ').map(n => n[0]).join('')}</span>
                </div>
              )}
              <h3 class="om-person__name">{person.name}</h3>
              <p class="om-person__title">{person.title}</p>
              <p class="om-person__bio">{person.bio}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--beige">
      <div class="container">
        <h2 class="section-title">Bestyrelse</h2>
        <div class="om-board">
          {board.map(member => (
            <article class="om-board-card">
              {member.image ? (
                <img
                  class="om-board-card__avatar"
                  src={member.image}
                  alt={`Portræt af ${member.name}`}
                  loading="lazy"
                  width="96"
                  height="96"
                  style={`object-position:${member.imagePosition}`}
                />
              ) : (
                <div class="om-board-card__avatar om-board-card__avatar--fallback" aria-hidden="true">
                  <span>{member.name.split(' ').map(n => n[0]).join('')}</span>
                </div>
              )}
              <h3 class="om-board-card__name">{member.name}</h3>
              <p class="om-board-card__role">{member.role}</p>
              <p class="om-board-card__focus">{member.focus}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--white">
      <div class="container">
        <h2 class="section-title">Vores historie</h2>
        <div class="om-story">
          <p>
            Well at Work udspringer af 20 års neurovidenskabelig forskning på Aarhus Universitet og University College London.
            Vores medstifter, professor Kim Mouridsen, har dedikeret sin karriere til at forstå, hvordan hjernen fungerer under pres
            — og hvordan tidlige kognitive forandringer kan afsløres, før de bliver til kliniske problemer.
          </p>
          <p>
            Det samme team har tidligere bygget Cercare Medical — en FDA-godkendt medicinsk AI-platform til hjerneskanning
            — og Mindway AI, der i dag bruges af over 13 millioner mennesker. Well at Work anvender den samme videnskabelige stringens
            og teknologiske tilgang, men rettet mod et andet problem: hvordan vi kan forstå og forbedre trivsel i organisationer
            på en måde, der faktisk virker.
          </p>
          <p>
            Vores ambition er at gøre det lettere at arbejde med trivsel i hverdagen. Derfor forbinder vi
            indsigt med personlige forløb, ledelsescoaching og opfølgning. Det giver både medarbejderen,
            lederen og HR en aktiv rolle i udviklingen.
          </p>
        </div>
      </div>
    </section>

    <section class="section section--navy">
      <div class="container" style="text-align:center;">
        <h2 style="font-family:var(--font-heading);font-size:var(--text-h1);margin-bottom:1rem;">Lad os tale sammen</h2>
        <p style="max-width:600px;margin:0 auto 2rem;opacity:0.85;line-height:1.7;">
          Fortæl os om jeres arbejdsplads. Vi viser, hvordan platformen kan støtte medarbejdere, ledere og HR.
        </p>
        <a href="/#kontakt" class="btn btn--white">Book en demo</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* Team grid */
  .om-team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--card-gap);
    margin-top: 2rem;
  }

  .om-person {
    background: var(--blush);
    border-radius: var(--card-radius);
    padding: 2rem;
    box-shadow: var(--card-shadow);
    border-top: 4px solid var(--lavender);
    text-align: center;
  }

  .om-person__avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background-color: var(--navy-dark);
    margin: 0 auto 1.25rem;
    object-fit: cover;
    object-position: center;
  }

  .om-person__avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .om-person__avatar span {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--white);
    letter-spacing: 0.05em;
  }

  .om-person__name {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    color: var(--navy);
    margin-bottom: 0.25rem;
  }

  .om-person__title {
    font-size: var(--text-small);
    color: var(--plum);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .om-person__bio {
    font-size: var(--text-small);
    color: var(--navy);
    line-height: 1.7;
  }

  /* Board */
  .om-board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--card-gap);
    max-width: 700px;
    margin: 2rem auto 0;
  }

  .om-board-card {
    background: var(--white);
    border-radius: var(--card-radius);
    padding: 2rem;
    box-shadow: var(--card-shadow);
    text-align: center;
  }

  .om-board-card__avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background-color: var(--steel-blue);
    margin: 0 auto 1rem;
    object-fit: cover;
  }

  .om-board-card__avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .om-board-card__avatar span {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--white);
    letter-spacing: 0.05em;
  }

  .om-board-card__name {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    color: var(--navy);
    margin-bottom: 0.25rem;
  }

  .om-board-card__role {
    font-size: var(--text-small);
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .om-board-card__focus {
    font-size: var(--text-small);
    color: var(--navy);
    font-weight: 500;
  }

  /* Company story */
  .om-story {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .om-story p {
    font-size: var(--text-body-lg);
    line-height: 1.8;
    color: var(--navy);
  }
</style>
