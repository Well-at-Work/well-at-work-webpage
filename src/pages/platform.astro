---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import PlatformOverview from '../components/PlatformOverview.astro';
import CoachPreview from '../components/CoachPreview.astro';
import TrackPreview from '../components/TrackPreview.astro';
const dataProducts = [
  { id: 'apv', label: 'ARBEJDSMILJØ', title: 'APV', text: 'Saml arbejdet med arbejdspladsvurderingen. Opret runder, invitér medarbejdere og få overblik over svar og resultater som grundlag for den videre indsats.', image: '/images/screenshots/apv-runder.webp', alt: 'APV-runder i Well at Work', features: ['Spørgeskemaer og målgrupper', 'Overblik over besvarelser og resultater', 'Et fælles grundlag for opfølgning'] },
  { id: 'atlas-individual', label: 'DEN ENKELTE MEDARBEJDER', title: 'Atlas Individual', text: 'Kombinér medarbejderens egen oplevelse med kognitive opgaver. Indsigt i trivsel, ressourcer og motivation danner grundlag for et personligt forløb.', image: '/images/screenshots/atlas-spoergsmaal.webp', alt: 'Spørgsmål i Atlas Individual', features: ['Selvrapportering og kognitive opgaver', 'Individuelle resultater og refleksion', 'Grundlag for et tilpasset forløb'] },
  { id: 'atlas-teams', label: 'SAMARBEJDE OG LEDELSE', title: 'Atlas Teams', text: 'Skab et fælles udgangspunkt for at udvikle teamet. Teamets samlede besvarelser og lederens perspektiv giver kontekst til coaching om samarbejde og ledelse.', image: '/images/screenshots/atlas-teams.webp', alt: 'Teamindsigt i Atlas Teams', features: ['Teamets og lederens perspektiver', 'Indsigt i samarbejde og teamdynamik', 'Kontekst til ledelsescoachen'] },
];
---
<Base title="Platform til trivsel, coaching og APV | Well at Work" description="Udforsk personlige forløb, ledelsescoach, APV, Atlas Individual, Atlas Teams og rapportering. Én platform til målrettede indsatser og opfølgning."><Navbar /><main id="main-content">
<section class="page-hero"><div class="container"><p class="eyebrow">WELL AT WORK PLATFORMEN</p><h1>Det hele hænger sammen.<br /><span style="color:var(--plum)">Det gør jeres indsats også.</span></h1><p class="section-subtitle">Giv medarbejdere og ledere støtte med afsæt i deres hverdag. Saml indsigt, personlige forløb, coaching og opfølgning i én platform.</p><a href="/#kontakt" class="btn btn--primary">Book en demo ↗</a><a href="#ledelsescoach" class="text-link">Se mulighederne</a></div></section>
<section class="section" id="ledelsescoach"><div class="container split"><div><p class="eyebrow">LEDELSESCOACH</p><h2 class="section-title">Et sted at vende<br />det svære i ledelse.</h2><p class="section-subtitle">AI-coachen tager afsæt i teamets samlede resultater og lederens perspektiv. Brug den til at undersøge en udfordring, forberede en samtale og finde en handling at prøve.</p><ul class="feature-list"><li>Coaching med kontekst fra Atlas Teams</li><li>Refleksion over samarbejde, tillid og retning</li><li>Konkrete næste skridt i lederens hverdag</li></ul><a href="/for-ledelsen" class="text-link">For ledere og ledelse</a></div><div class="coach-frame"><CoachPreview /></div></div></section>
<section class="section section--beige" id="personlige-forloeb"><div class="container split"><div class="track-stage"><TrackPreview /></div><div><p class="eyebrow">PERSONLIGE FORLØB</p><h2 class="section-title">Støtte med afsæt<br />i den enkelte.</h2><p class="section-subtitle">Efter sin individuelle vurdering kan medarbejderen starte et tilpasset forløb. Korte øvelser og refleksioner hjælper med at arbejde med trivsel og vaner over 14 dage.</p><ul class="feature-list"><li>Forløb valgt ud fra individuelle resultater</li><li>Øvelser i blandt andet energi, pauser og ressourcer</li><li>Personlig opfølgning på gennemførte aktiviteter</li></ul><a href="/for-medarbejdere" class="text-link">For medarbejdere</a></div></div></section>
<PlatformOverview />
<section class="section"><div class="container"><div class="section-intro"><p class="eyebrow">INDSIGTEN BAG STØTTEN</p><h2 class="section-title">Forstå mennesker.<br />Forstå arbejdspladsen.</h2><p class="section-subtitle">Tre perspektiver hjælper jer med at vælge relevante indsatser for den enkelte, teamet og organisationen.</p></div><div class="data-products">{dataProducts.map(product => <article class="data-product" id={product.id}><div class="data-image"><img src={product.image} alt={product.alt} loading="lazy" /></div><p class="eyebrow">{product.label}</p><h3>{product.title}</h3><p>{product.text}</p><ul class="feature-list">{product.features.map(feature => <li>{feature}</li>)}</ul></article>)}</div></div></section>
<section class="section section--beige" id="rapportering"><div class="container"><div class="split report-intro"><div><p class="eyebrow">ANALYSE & RAPPORTERING</p><h2 class="section-title">Overblik til at prioritere.<br />Indsigt til at følge op.</h2></div><p class="section-subtitle">Se samlede mønstre på tværs af organisationen og følg udviklingen over tid. Brug rapporterne til at drøfte indsatser, prioritere ressourcer og tage erfaringerne med ind i næste skridt.</p></div><div class="product-frame"><img src="/images/screenshots/org-overblik.webp" width="1600" height="1000" alt="Organisationsoverblik med aggregerede resultater i Well at Work" loading="lazy" /></div><p class="product-caption">Eksempel fra platformen. Resultater og visninger afhænger af jeres datagrundlag.</p><div class="learning-direction"><h3>Støtte, der lærer, hvad der hjælper jer.</h3><p>Vi arbejder hen imod en platform, der bruger erfaringer fra indsatser og opfølgning til løbende at gøre anbefalingerne mere relevante for medarbejderen og teamet.</p></div></div></section>
<section class="section" id="privatliv"><div class="container split"><div><p class="eyebrow">PRIVATLIV I PLATFORMEN</p><h2 class="section-title">Plads til ærlighed.<br />Respekt for den enkelte.</h2></div><div class="prose"><p>Medarbejderen arbejder med sine egne resultater og sit personlige forløb. HR og ledelsen bruger samlede indsigter til arbejdet med organisationen.</p><p>Teamindsigt til coachen bygger på aggregerede besvarelser. Der kræves mindst fem respondenter, før teamets samlede scorer er tilgængelige.</p><p>På en demo gennemgår vi, hvem der har adgang til hvilke oplysninger, og hvordan platformen passer til jeres organisation.</p><a href="/#kontakt" class="text-link" style="margin-top:1.5rem">Tal med os om data og adgang</a></div></div></section>
<Contact /></main><Footer /></Base>
<style>
.coach-frame { padding: 28px; }
.track-stage { padding: 20px; }
.data-products { display: grid; grid-template-columns: repeat(3,1fr); gap: 2rem; }
.data-product { scroll-margin-top: 110px; }
.data-image { height: 215px; border-radius: 12px; overflow: hidden; background: var(--surface); padding: 12px; border: 1px solid var(--border); margin-bottom: 1.5rem; }
.data-image img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 5px; }
.data-product .eyebrow { font-size: .6rem; margin-bottom: .6rem; }
.data-product h3 { font-size: 1.6rem; font-weight: 600; letter-spacing: var(--heading-spacing); margin-bottom: 1rem; }
.data-product > p:not(.eyebrow) { font-size: .9rem; color: var(--text-muted); line-height: 1.75; }
.data-product .feature-list { font-size: .78rem; }
.learning-direction { max-width: 740px; border-left: 2px solid var(--bronze); padding-left: 20px; margin-top: 2.5rem; }
.learning-direction h3 { color: var(--plum); font-size: 1.2rem; font-weight: 600; margin-bottom: .6rem; }
.learning-direction p { color: var(--text-muted); font-size: .9375rem; line-height: 1.75; }
.report-intro { margin-bottom: 2rem; }
.report-intro .section-subtitle { margin: 0; }
@media(max-width:800px) { .data-products { grid-template-columns: 1fr; gap: 2.5rem; } .data-image { height: 280px; } #personlige-forloeb .split > div:last-child { order: -1; } }
</style>
