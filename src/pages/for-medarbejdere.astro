---
import Audience from '../layouts/Audience.astro';
import TrackPreview from '../components/TrackPreview.astro';
const benefits = [
  { title: 'Et forløb med dig i centrum', text: 'Din individuelle vurdering danner grundlag for et personligt forløb. Du får øvelser, der tager afsæt i din situation og dine behov.' },
  { title: 'Små skridt i din hverdag', text: 'Arbejd med blandt andet energi, pauser og de vaner, der støtter dig. Øvelserne er korte og konkrete, så du kan prøve dem i praksis.' },
  { title: 'Plads til din refleksion', text: 'Dine resultater og dit forløb giver dig et personligt rum til at blive klogere på dig selv. Organisationen arbejder med samlede indsigter.' },
];
---
<Audience title="Personlige forløb for medarbejdere" label="FOR MEDARBEJDERE" heading="En bedre arbejdsdag. Ét skridt ad gangen." description="Lær dine ressourcer bedre at kende, og få støtte til at styrke din trivsel. Dit personlige forløb gør det let at tage små, konkrete skridt i hverdagen." benefits={benefits}>
<section class="section"><div class="container split"><div class="preview-stage"><TrackPreview /></div><div><p class="eyebrow">DIT PERSONLIGE FORLØB</p><h2 class="section-title">Find det, der giver<br />dig mere overskud.</h2><p class="section-subtitle">Et forløb kan for eksempel hjælpe dig med at opdage, hvad der giver og tager energi, skabe plads til pauser og holde fast i gode vaner.</p><ul class="feature-list"><li>Start med din individuelle vurdering</li><li>Få et tilpasset forløb over 14 dage</li><li>Arbejd med øvelser og følg dine egne aktiviteter</li></ul><a href="/platform#personlige-forloeb" class="text-link">Læs om personlige forløb</a></div></div></section>
<section class="section section--beige"><div class="container split"><div><p class="eyebrow">SPØRGSMÅL OM DIN DELTAGELSE?</p><h2 class="section-title">Du skal vide,<br />hvad du er med til.</h2></div><div class="prose"><p>Din arbejdsplads hjælper dig med at komme i gang. Kontakt din HR-kontakt, hvis du har spørgsmål om invitationen, deltagelsen eller forløbet i jeres organisation.</p><p>Du er også velkommen til at skrive til os om platformen og om, hvordan dine oplysninger bliver brugt.</p><a class="text-link" href="mailto:info@bewellatwork.dk" style="margin-top:1.5rem">Kontakt Well at Work</a></div></div></section>
</Audience>

<style>
.preview-stage { padding: 24px; }
@media(max-width:480px) { .preview-stage { padding: 8px; } }
</style>
