---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
const principles = [
  { title: 'Støtte på flere niveauer', text: 'WHO’s retningslinjer for mental sundhed på arbejdspladsen omfatter både organisatoriske indsatser, ledertræning og individuelle indsatser. Det understøtter en tilgang, hvor medarbejderens støtte ses sammen med arbejdspladsens rammer.', source: 'WHO · Guidelines on mental health at work, 2022', href: 'https://www.who.int/publications/i/item/9789240053052' },
  { title: 'Krav og ressourcer i sammenhæng', text: 'Job Demands–Resources-teorien beskriver, hvordan krav og ressourcer i arbejdet hænger sammen med belastning og engagement. Den giver et fagligt grundlag for at arbejde med både udfordringerne og de ressourcer, der støtter medarbejderen.', source: 'Bakker & Demerouti · Journal of Occupational Health Psychology, 2017', href: 'https://pubmed.ncbi.nlm.nih.gov/27732008/' },
  { title: 'Flere perspektiver på trivsel', text: 'Forskning har vist sammenhænge mellem psykosocial stress og opmærksomhedskontrol. Kognitive opgaver kan derfor være et supplerende perspektiv til medarbejderens egen beskrivelse af sin situation.', source: 'Liston, McEwen & Casey · PNAS, 2009', href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC2621252/' },
];
const leadershipEvidence = [
  { title: 'Ledelse hænger sammen med medarbejdernes trivsel', text: 'En metaanalyse af 53 studier med 93.470 deltagere finder sammenhænge mellem ledelsesstil og medarbejdernes mentale sundhed. Relations- og opgaveorienteret ledelse har særligt stærke sammenhænge med positive mål for trivsel. Studierne viser sammenhænge; de dokumenterer ikke i sig selv, at en bestemt lederindsats skaber bedre trivsel.', source: 'Montano, Schleu & Hüffmeier · Journal of Leadership & Organizational Studies, 2023', href: 'https://doi.org/10.1177/15480518221114854' },
  { title: 'Lederudvikling skal omsættes til praksis', text: 'En metaanalyse af 335 uafhængige stikprøver finder positive resultater af ledertræning på læring, anvendelse i arbejdet og resultater. Analyserne peger på værdien af behovsafdækning, feedback, praktiske øvelser og træning fordelt over tid. De støtter også faciliteret træning med fysisk fremmøde. Det inspirerer vores fokus på teamets behov og konkrete handlinger, men dokumenterer ikke effekten af automatiseret coaching.', source: 'Lacerenza et al. · Journal of Applied Psychology, 2017', href: 'https://pubmed.ncbi.nlm.nih.gov/28749153/' },
  { title: 'Coaching har et forskningsgrundlag', text: 'En metaanalyse med 2.528 deltagere på tværs af de analyserede randomiserede forsøg finder en moderat gennemsnitlig effekt af coaching på de undersøgte personlige og ledelsesmæssige mål (Hedges’ g = 0,59). Effekterne er større ved selvrapportering, og forfatterne finder tegn på publikationsbias. Resultaterne gælder coaching generelt og kan ikke overføres direkte til en AI-coach.', source: 'De Haan & Nilsson · Academy of Management Learning & Education, 2023', href: 'https://doi.org/10.5465/amle.2022.0107' },
];
---
<Base title="Forskning og fagligt grundlag | Well at Work" description="Læs om det faglige grundlag for Well at Work: støtte på flere niveauer, krav og ressourcer samt neurovidenskabelige perspektiver på trivsel."><Navbar /><main id="main-content"><section class="page-hero"><div class="container"><p class="eyebrow">FORSKNING & FAGLIGHED</p><h1>Viden om mennesker.<br />Omsat til støtte i hverdagen.</h1><p class="section-subtitle">Well at Work forbinder indsigt i den enkelte med udvikling af ledelse og arbejdsplads. Vores tilgang trækker på psykologi, organisationsforskning og neurovidenskab.</p><a href="/platform" class="text-link">Se, hvordan det bliver til praksis</a></div></section>
<section class="section"><div class="container"><div class="section-intro"><p class="eyebrow">DET FAGLIGE GRUNDLAG</p><h2 class="section-title">Tre perspektiver.<br />Et samlet arbejde med trivsel.</h2></div><div class="research-list">{principles.map((principle,index) => <article><span class="research-number">0{index + 1}</span><div><h3>{principle.title}</h3><p>{principle.text}</p><a href={principle.href} target="_blank" rel="noopener noreferrer">{principle.source} <span aria-hidden="true">↗</span></a></div></article>)}</div><p class="research-note">Referencerne beskriver det generelle forskningsgrundlag. De er ikke i sig selv dokumentation for effekten af Well at Work-platformen.</p></div></section>
<section class="section section--beige" id="ledelse-og-coaching"><div class="container"><div class="section-intro"><p class="eyebrow">LEDELSE & COACHING</p><h2 class="section-title">Ledelse er for vigtig<br />til at overlade til tilfældigheder.</h2><p class="section-subtitle">Forskningen giver gode grunde til at prioritere lederudvikling — og til at stille krav til, hvordan støtten virker i praksis.</p></div><div class="research-list">{leadershipEvidence.map((study,index) => <article><span class="research-number">0{index + 1}</span><div><h3>{study.title}</h3><p>{study.text}</p><a href={study.href} target="_blank" rel="noopener noreferrer">{study.source} <span aria-hidden="true">↗</span></a></div></article>)}</div><div class="ai-evidence prose"><h3>Hvad ved vi om AI-coaching?</h3><p>Evidensen er under udvikling og viser blandede resultater. Et studie fra 2022, der sammenlignede to separate randomiserede forsøg, fandt bedre målopnåelse med både menneskelig coaching og en AI-coach end i kontrolgrupperne. Et direkte randomiseret forsøg fra 2026 med 114 deltagere fandt derimod væsentlige forbedringer alene i gruppen med menneskelig coaching.</p><p class="study-links"><a href="https://pubmed.ncbi.nlm.nih.gov/35727801/" target="_blank" rel="noopener noreferrer">Terblanche et al. · PLOS ONE, 2022 ↗</a><a href="https://doi.org/10.1080/13678868.2026.2633990" target="_blank" rel="noopener noreferrer">De Haan, Terblanche & Nowack · 2026 ↗</a></p><p>Studierne undersøger bestemte systemer og forløb. De dokumenterer ikke effekten af Well at Works AI-coach. Vi bruger forskningen til at kvalificere tilgangen; effekten af vores egen løsning skal undersøges særskilt.</p></div></div></section>
<section class="section"><div class="container split"><div><p class="eyebrow">FRA VIDEN TIL PRAKSIS</p><h2 class="section-title">Relevante indsatser.<br />Løbende opfølgning.</h2></div><div class="prose"><p>Atlas Individual kombinerer selvrapportering og kognitive opgaver som grundlag for individuelle resultater og personlige forløb. Atlas Teams giver kontekst til ledelsescoaching, mens APV belyser arbejdspladsens rammer.</p><p>Analyse og rapportering hjælper med at følge udviklingen. Resultaterne bruges som grundlag for dialog og prioritering; en ændring over tid kan have flere årsager.</p><a href="/platform" class="text-link" style="margin-top:1.5rem">Udforsk platformen</a></div></div></section>
<section class="section"><div class="container split"><div><p class="eyebrow">TEAMET BAG</p><h2 class="section-title">Faglighed møder<br />produktudvikling.</h2></div><div class="prose"><p>Teamet samler erfaring fra neurovidenskab, organisationspsykologi, personlige udviklingsforløb og anvendt AI. Den kombination bruger vi til at gøre indsigter anvendelige for medarbejdere, ledere og HR.</p><a href="/om-os" class="text-link" style="margin-top:1.5rem">Mød teamet</a></div></div></section><Contact /></main><Footer /></Base>
<style>
.research-list { max-width: 950px; }
.research-list article { display: grid; grid-template-columns: 65px 1fr; gap: 2rem; border-top: 1px solid var(--border); padding: 2.5rem 0; }
.research-number { color: var(--plum); font-size: .9rem; padding-top: .3rem; }
.research-list h3 { font-size: 1.65rem; font-weight: 600; letter-spacing: var(--heading-spacing); margin-bottom: 1rem; }
.research-list p { color: var(--text-muted); line-height: 1.8; font-size: .98rem; margin-bottom: 1.2rem; }
.research-list a { font-size: .77rem; color: var(--plum); text-decoration: underline; text-underline-offset: 4px; }
.research-note { font-size: .8rem; color: var(--text-muted); max-width: 800px; border-left: 3px solid var(--plum); padding-left: 1.2rem; margin-top: 1rem; }
#ledelse-og-coaching { scroll-margin-top: 110px; }
.ai-evidence { border-top: 1px solid var(--border); padding-top: 2rem; margin-top: 1rem; }
.ai-evidence h3 { color: var(--ink); font-size: 1.4rem; margin-bottom: 1rem; }
.study-links { display: flex; flex-direction: column; align-items: flex-start; gap: .6rem; font-size: .78rem; }
.study-links a { color: var(--plum); text-decoration: underline; text-underline-offset: 3px; }
@media(max-width:600px) { .research-list article { grid-template-columns: 30px 1fr; gap: 1rem; } }
</style>
